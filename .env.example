# Copy to .env.local and fill in. Only SESSION_SECRET is required to run the app locally.

# Signs sessions, sign-in codes and links. Any random string of 32+ characters.
SESSION_SECRET=

# Where the app runs; used in emails and share links.
APP_ORIGIN=http://localhost:3000

# Leave empty to use the embedded Postgres in .data/. Set postgres://... to use a real server.
DATABASE_URL=

# Comma-separated emails that get the Ops console.
STAFF_EMAILS=

# Protects POST /api/jobs/run (auto-approval and reminders). `npm run jobs` sends it.
CRON_SECRET=

# Evra, the AI assistant. Without a key the app works and the assistant says it's unavailable.
ANTHROPIC_API_KEY=
# EVRA_MODEL=claude-haiku-5-5

# Optional: public Instagram checks for account verification.
APIFY_TOKEN=

# Optional: sign-in code limit per email per hour (default 5).
# OTP_MAX_PER_HOUR=5
